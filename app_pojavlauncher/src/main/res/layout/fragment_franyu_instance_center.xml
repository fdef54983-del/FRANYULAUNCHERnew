<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background_app" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/instance_center_home"
            style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent"
            android:text="Volver al inicio" android:drawableStart="@drawable/ic_px_home"
            android:drawableTint="@color/emerald_accent"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="CENTRO DE INSTANCIAS"
            android:textColor="@color/emerald_accent" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Administra, selecciona y organiza tus perfiles de Minecraft."
            android:textColor="@color/secondary_text" android:textSize="13sp"/>
        <com.kdt.mcgui.LauncherMenuButton android:id="@+id/instance_center_new"
            style="@style/LauncherMenuButton.Universal" android:layout_width="match_parent"
            android:layout_marginTop="14dp" android:text="Crear nueva instancia"
            android:drawableStart="@drawable/ic_px_edit" android:drawableTint="@color/emerald_accent"/>
        <LinearLayout android:id="@+id/instance_center_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>