<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_app"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CENTRO DE INSTANCIAS"
                    android:textColor="@color/emerald_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Todas tus instancias en un solo lugar"
                    android:textColor="@color/primary_text"
                    android:textSize="21sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/instance_center_home"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Inicio"
                android:textColor="@color/emerald_accent"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Selecciona una instancia para convertirla en la activa. Mantén pulsada una para ver acciones."
            android:textColor="@color/secondary_text"
            android:textSize="13sp"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/instance_center_new"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:text="Crear nueva instancia"
            android:drawableStart="@drawable/ic_px_plus"
            android:drawableTint="@color/emerald_accent"/>

        <LinearLayout
            android:id="@+id/instance_center_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
